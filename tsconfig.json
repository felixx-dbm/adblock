{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["chrome", "node"]
  },
  "include": ["src", "scripts", "tests", "esbuild.config.ts", "playwright.config.ts", "vitest.config.ts"]
}
